{
    "name": "ethanbarlo/intermingle",
    "description": "Deeply integrate React into Livewire",
    "keywords": [
        "EthanBarlo",
        "laravel",
        "intermingle"
    ],
    "homepage": "https://github.com/ethanbarlo/intermingle",
    "license": "MIT",
    "authors": [
        {
            "name": "Ethan Barlow",
            "email": "ethanbar266@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^10.0||^11.0",
        "livewire/livewire": "^4.2",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "larastan/larastan": "^2.9",
        "orchestra/testbench": "^9.0.0||^8.22.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-phpunit": "^1.3",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "EthanBarlo\\Intermingle\\": "src/",
            "EthanBarlo\\Intermingle\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EthanBarlo\\Intermingle\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EthanBarlo\\Intermingle\\IntermingleServiceProvider"
            ],
            "aliases": {
                "Intermingle": "EthanBarlo\\Intermingle\\Facades\\Intermingle"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
